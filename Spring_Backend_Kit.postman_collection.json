            "description": "Returns Prometheus metrics. Run Login first so `accessToken` is populated."
          },
          "response": []
        }
      ]
    },
    {
      "name": "01 - Registration and Login",
      "description": "Creates and verifies a user, then logs in. Verification requires copying the local-development token from `docker compose logs spring-backend` into `verificationToken`.",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const generate = pm.collectionVariables.get('generateNewUserEmail') === 'true';",
                  "const current = pm.collectionVariables.get('userEmail');",
                  "if (generate || !current) {",
                  "    const email = `postman-${Date.now()}-${Math.floor(Math.random() * 100000)}@example.com`;",
                  "    pm.collectionVariables.set('userEmail', email);",
                  "    pm.collectionVariables.set('generateNewUserEmail', 'false');",
                  "    console.log(`Generated collection userEmail: ${email}`);",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Registration message is returned', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.message).to.include('Registration successful');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Request-Id",
                "value": "{{requestId}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "description": "Registers a pending user. Set `generateNewUserEmail` to `true` before resending if you want another unique account. The verification token is written to the `spring-backend` service logs."
          },
          "response": []
        },
        {
          "name": "Resend Verification",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Generic response does not disclose account state', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.message).to.include('If an account requires verification');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Request-Id",
                "value": "{{requestId}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/resend-verification",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "resend-verification"]
            },
            "description": "Generates a fresh verification token for a pending user. Copy the newest token from the application logs into `verificationToken`."
          },
          "response": []
        },
        {
          "name": "Verify Email",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('verificationToken')) {",
                  "    console.warn('Set collection variable verificationToken from: docker compose logs spring-backend');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 204', function () { pm.response.to.have.status(204); });",
                  "if (pm.response.code === 204) { pm.collectionVariables.set('verificationToken', ''); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Request-Id",
                "value": "{{requestId}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{verificationToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/verify-email",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "verify-email"]
            },
            "description": "Activates the account with the single-use verification token copied from local application logs."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Bearer token pair is returned', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.accessToken).to.be.a('string').and.not.empty;",
                  "    pm.expect(json.refreshToken).to.be.a('string').and.not.empty;",
                  "    pm.expect(json.tokenType).to.eql('Bearer');",
                  "    pm.expect(json.expiresIn).to.be.a('number');",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('accessToken', json.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Request-Id",
                "value": "{{requestId}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Authenticates a verified active user. Successful responses automatically populate `accessToken` and `refreshToken`."
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 - User Profile",
      "description": "Authenticated self-service user endpoints. Run Login first.",
      "item": [
        {
          "name": "Get My Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Profile contains public user fields', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.id).to.be.a('string');",
                  "    pm.expect(json.email).to.eql(pm.collectionVariables.get('userEmail'));",
                  "    pm.expect(json.roles).to.be.an('array').and.to.include('USER');",
                  "    pm.expect(json.status).to.eql('ACTIVE');",
                  "    pm.expect(json).to.not.have.property('passwordHash');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "X-Request-Id",
                "value": "{{requestId}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "me"]
            },
            "description": "Returns the authenticated user's safe profile representation."
          },
          "response": []
        },
        {
          "name": "Update My Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Profile names are updated', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.firstName).to.eql(pm.collectionVariables.get('profileFirstName'));",
                  "    pm.expect(json.lastName).to.eql(pm.collectionVariables.get('profileLastName'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Request-Id",
                "value": "{{requestId}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"{{profileFirstName}}\",\n  \"lastName\": \"{{profileLastName}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "me"]
            },
            "description": "Updates first and last name for the authenticated user."
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 - Token Lifecycle",
      "description": "Exercises rotating refresh tokens and logout. Logout revokes the current refresh token and clears local collection token values.",
      "item": [
        {
          "name": "Refresh Access Token",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('previousRefreshToken', pm.collectionVariables.get('refreshToken'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Refresh token rotates', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.accessToken).to.be.a('string').and.not.empty;",
                  "    pm.expect(json.refreshToken).to.be.a('string').and.not.empty;",
                  "    pm.expect(json.refreshToken).to.not.eql(pm.variables.get('previousRefreshToken'));",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('accessToken', json.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Request-Id",
                "value": "{{requestId}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "refresh"]
            },
            "description": "Rotates the current refresh token and stores the returned access/refresh pair."
          },
          "response": []
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 204', function () { pm.response.to.have.status(204); });",
                  "if (pm.response.code === 204) {",
                  "    pm.collectionVariables.set('accessToken', '');",
                  "    pm.collectionVariables.set('refreshToken', '');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Request-Id",
                "value": "{{requestId}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "logout"]
            },
            "description": "Revokes the supplied refresh token. Run this only when you are ready to end the current collection session."
          },
          "response": []
        }
      ]
    },
    {
      "name": "04 - Password Recovery",
      "description": "Password recovery flow. The local reset token is emitted to application logs and must be copied into `resetToken`.",
      "item": [
        {
          "name": "Forgot Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Generic response prevents account enumeration', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.message).to.include('If an account exists');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Request-Id",
                "value": "{{requestId}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "forgot-password"]
            },
            "description": "Requests password recovery without revealing whether the email exists. Copy the emitted token to `resetToken`."
          },
          "response": []
        },
        {
          "name": "Reset Password",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('resetToken')) {",
                  "    console.warn('Set collection variable resetToken from: docker compose logs spring-backend');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 204', function () { pm.response.to.have.status(204); });",
                  "if (pm.response.code === 204) {",
                  "    pm.collectionVariables.set('userPassword', pm.collectionVariables.get('newPassword'));",
                  "    pm.collectionVariables.set('resetToken', '');",
                  "    pm.collectionVariables.set('accessToken', '');",
                  "    pm.collectionVariables.set('refreshToken', '');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Request-Id",
                "value": "{{requestId}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "reset-password"]
            },
            "description": "Consumes the single-use reset token, changes the password, revokes all refresh sessions, and updates `userPassword` for subsequent Login requests."
          },
          "response": []
        },
        {
          "name": "Login After Password Reset",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('accessToken', json.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
